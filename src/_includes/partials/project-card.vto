<article class="project-card"><a class="card-link" href="{{ project.url }}" aria-label="{{ project.title }}"></a>{{ if project.image }}<img src="{{ project.image }}" alt="{{ project.title }}" loading="lazy">{{ /if }}<div class="card-top"><span class="badge badge-{{ project.projectType }}">{{ project.projectType === 'app' ? 'iOS App' : project.projectType === 'research' ? 'Research' : 'Project' }}</span>{{ if project.stats }}<span class="stat">{{ project.stats }}</span>{{ /if }}</div><h2>{{ project.title }}</h2><p>{{ project.description }}</p><div class="tags">{{ for tag of project.tags }}<a href="/tags/{{ tag |> slugify }}/">#{{ tag }}</a>{{ /for }}</div></article>
